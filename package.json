{
  "name": "lawcrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write --ignore-unknown",
    "format:check": "prettier --check --ignore-unknown",
    "test": "vitest run",
    "test:utc": "TZ=UTC vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:destructive-migrations": "tsx scripts/check-destructive-migrations.ts",
    "test:related": "vitest related --run --passWithNoTests",
    "precommit": "npm run typecheck && npm run lint",
    "prepare": "husky",
    "clerk:preflight": "tsx --conditions=react-server scripts/clerk-preflight.ts",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@clerk/nextjs": "^7.9.17",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kenjiuno/msgreader": "1.28.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "4.9.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.2",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.13.0",
    "docx-preview": "^0.4.0",
    "dotenv": "^17.4.2",
    "fontkit": "2.0.4",
    "heic-to": "1.6.5",
    "lucide-react": "^1.9.0",
    "mammoth": "^1.12.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.20.0",
    "postal-mime": "4.0.2",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.10",
    "sanitize-html": "^2.17.3",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "utif": "3.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jszip": "^3.10.2",
    "prettier": "3.9.10",
    "shadcn": "^4.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
