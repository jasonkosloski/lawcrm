# Copy to .env and fill in. Never commit your real .env.

# Database — Postgres in every environment now.
#
# Production (Vercel): DATABASE_URL is injected by the Prisma Postgres
# integration (resource prisma-postgres-cinereous-button). Leave
# DIRECT_DATABASE_URL unset there unless migrations need a separate
# non-pooled URL.
#
# Local dev: use the separate dev database — Vercel resource
# `lawcrm-dev`, exposed to the Development env as DEVDB_DATABASE_URL.
# Copy that value into BOTH lines below. Never use the production
# DATABASE_URL locally (the seed resets data + passwords).
# `npm run db:seed` / `db:reset` are destructive and refuse to run unless
# the database host is localhost/127.0.0.1/::1. For the hosted
# `lawcrm-dev` DB, opt in per run: ALLOW_SEED=1 npm run db:seed
# (never honored when NODE_ENV/VERCEL_ENV is production).
# SEED_ADMIN_PASSWORD sets the demo users' password; when unset the seed
# generates a random one and prints it once.
# SEED_ADMIN_PASSWORD=
# Tests use a separate URL (default localhost:5433/lawcrm_test, set in
# src/test/integration-setup.ts) so this DATABASE_URL won't get
# clobbered when you run `npm test`. To run two suites at once (git
# worktrees, parallel sessions), give each its own database in the
# test container and point TEST_DATABASE_URL at it; it must be a
# local database named lawcrm_test*.
# TEST_DATABASE_URL=postgresql://lawcrm_test:lawcrm_test@localhost:5433/lawcrm_test_2
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lawcrm_dev"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lawcrm_dev"

# Optional. Max connections in each server instance's pool (default 5).
# Vercel Fluid compute runs concurrent requests in one instance that
# share this pool; instances x this value must stay below the database
# plan's connection cap.
# DATABASE_POOL_MAX=5

# Auth.js — used to sign session JWTs and CSRF tokens. Generate
# with: openssl rand -base64 32. Required in every environment.
AUTH_SECRET=

# Authenticates Vercel Cron (REQUIRED in production). Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>` to /api/email-sync (every 5 min:
# Gmail + Google Calendar sync) and /api/notification-sweep (hourly:
# deadline notifications). Unset => both return 401 (fail closed) and
# the background syncs silently stop; only the dashboard's opportunistic
# sweep keeps running. Generate with: openssl rand -base64 32. Set it in
# the Vercel Production environment; local dev does not need it.
CRON_SECRET=

# Encrypts EmailAccount OAuth tokens (access/refresh) at rest —
# AES-256-GCM, enforced by a Prisma extension (src/lib/email-token-
# encryption.ts). Generate with: openssl rand -base64 32. Required
# before connecting any Gmail account. Rotating it orphans existing
# tokens (users reconnect their accounts) — don't lose it casually.
EMAIL_TOKEN_KEY=

# Document storage (ADR-015). Two drivers behind src/lib/file-storage.ts:
#
#   local        ./uploads/ on disk — dev default, zero setup.
#   vercel-blob  Vercel Blob — REQUIRED in production (the Vercel
#                serverless filesystem is ephemeral). Auto-selected
#                whenever BLOB_READ_WRITE_TOKEN is set.
#
# Production (Vercel): create a Blob store on the project — Vercel
# injects BLOB_READ_WRITE_TOKEN automatically. Nothing else to set.
#
# Local dev: leave BOTH unset. If `vercel env pull` drops the token
# into your .env, set STORAGE_DRIVER=local to stay on disk — client-
# direct blob uploads DON'T finish on localhost (Vercel's completion
# callback can't reach you), so blob-driver dev needs a tunnel.
# BLOB_READ_WRITE_TOKEN=
# STORAGE_DRIVER=local
# Blob-driver dev behind a tunnel only (e.g. ngrok): the public URL
# Vercel's upload-completion callback should hit.
# VERCEL_BLOB_CALLBACK_URL=

# Optional. Auth.js v5 derives the URL from the request host by
# default — set this explicitly only when running behind a proxy/CDN.
# AUTH_URL="http://localhost:3000"

# Gmail + Google Calendar integration (per-user OAuth on
# /settings/integrations). Create an OAuth 2.0 Client ID (type "Web
# application") in the Google Cloud console with BOTH the Gmail API and
# the Google Calendar API enabled (calendar sync 403s with
# accessNotConfigured otherwise), then register
# the callback as an authorized redirect URI FOR EVERY ORIGIN the
# app runs on — Google rejects unregistered ones:
#
#   http://localhost:3000/api/integrations/google/callback   (dev)
#   https://<your-domain>/api/integrations/google/callback   (prod)
#
# The app derives the redirect URI from the request origin (or
# AUTH_URL when set) — never hardcoded. Scopes requested (add all of
# them to the OAuth consent screen): gmail.modify, gmail.send,
# calendar.events, openid, email. Accounts connected before the
# calendar scope was added must reconnect to grant it. When unset, the
# integrations page shows setup guidance instead of a connect
# button. EMAIL_TOKEN_KEY (above) must also be set — tokens are
# encrypted at rest.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Future providers (uncomment + set when wiring Google SIGN-IN via
# Auth.js — separate from the Gmail integration credentials above):
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Outbound email (client portal). Unset RESEND_API_KEY = log emails to the console.
RESEND_API_KEY=""
EMAIL_FROM="Firm Name <noreply@example.com>"

# Client portal host (no scheme, no port), e.g. portal.example.com. The proxy
# serves /portal/* pages at the root of this host and 404s /portal on the
# staff host. In development `portal.localhost:3000` is always the portal
# host (no env needed).
PORTAL_HOST=""
